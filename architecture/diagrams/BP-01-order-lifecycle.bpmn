<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BP01" targetNamespace="https://example.com/bpmn/order-lifecycle" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collab_BP01">
    <bpmn:participant id="CustomerPool" name="Заказчик" processRef="CustomerProcess" />
    <bpmn:participant id="SystemPool" name="Система" processRef="SystemProcess" />
    <bpmn:participant id="CarrierPool" name="Перевозчик" processRef="CarrierProcess" />
    <bpmn:messageFlow id="MF_publish" name="заявка опубликована" sourceRef="C_publish" targetRef="S_start" />
    <bpmn:messageFlow id="MF_offer" name="заказ доступен" sourceRef="S_offer" targetRef="D_start" />
    <bpmn:messageFlow id="MF_response" name="отклик" sourceRef="D_respond" targetRef="S_response" />
    <bpmn:messageFlow id="MF_responseCustomer" name="отклик" sourceRef="S_sendResponse" targetRef="C_response" />
    <bpmn:messageFlow id="MF_accept" name="принятие" sourceRef="C_accept" targetRef="S_accept" />
    <bpmn:messageFlow id="MF_acceptCarrier" name="заказ принят" sourceRef="S_sendAccept" targetRef="D_accept" />
    <bpmn:messageFlow id="MF_done" name="заказ выполнен" sourceRef="D_done" targetRef="S_done" />
    <bpmn:messageFlow id="MF_notify" name="уведомление" sourceRef="S_notify" targetRef="C_done" />
    <bpmn:messageFlow id="MF_confirm" name="подтверждение" sourceRef="C_confirm" targetRef="S_confirm" />
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:startEvent id="C_start" name="Начало" />
    <bpmn:userTask id="C_create" name="Создать заявку" />
    <bpmn:userTask id="C_publish" name="Опубликовать заказ" />
    <bpmn:intermediateCatchEvent id="C_response" name="Получить отклик" />
    <bpmn:userTask id="C_negotiate" name="Участвовать в торге" />
    <bpmn:userTask id="C_accept" name="Принять перевозчика" />
    <bpmn:intermediateCatchEvent id="C_done" name="Получить уведомление" />
    <bpmn:userTask id="C_confirm" name="Подтвердить выполнение" />
    <bpmn:endEvent id="C_end" name="Завершено" />
    <bpmn:sequenceFlow id="C1" sourceRef="C_start" targetRef="C_create" />
    <bpmn:sequenceFlow id="C2" sourceRef="C_create" targetRef="C_publish" />
    <bpmn:sequenceFlow id="C3" sourceRef="C_publish" targetRef="C_response" />
    <bpmn:sequenceFlow id="C4" sourceRef="C_response" targetRef="C_negotiate" />
    <bpmn:sequenceFlow id="C5" sourceRef="C_negotiate" targetRef="C_accept" />
    <bpmn:sequenceFlow id="C6" sourceRef="C_accept" targetRef="C_done" />
    <bpmn:sequenceFlow id="C7" sourceRef="C_done" targetRef="C_confirm" />
    <bpmn:sequenceFlow id="C8" sourceRef="C_confirm" targetRef="C_end" />
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="S_start" name="Получить заявку" />
    <bpmn:serviceTask id="S_publish" name="Опубликовать заказ" />
    <bpmn:sendTask id="S_offer" name="Показать заказ перевозчикам" />
    <bpmn:intermediateCatchEvent id="S_response" name="Получить отклик" />
    <bpmn:serviceTask id="S_trade" name="Организовать торг" />
    <bpmn:sendTask id="S_sendResponse" name="Передать отклик заказчику" />
    <bpmn:intermediateCatchEvent id="S_accept" name="Получить принятие" />
    <bpmn:serviceTask id="S_execution" name="Зафиксировать выполнение" />
    <bpmn:intermediateCatchEvent id="S_confirm" name="Получить подтверждение" />
    <bpmn:endEvent id="S_end" name="Конец" />
    <bpmn:serviceTask id="S_complete" name="Завершить заказ" />
    <bpmn:sendTask id="S_notify" name="Уведомить заказчика" />
    <bpmn:intermediateCatchEvent id="S_done" name="Получить отметку о выполнении" />
    <bpmn:sendTask id="S_sendAccept" name="Передать заказ перевозчику" />
    <bpmn:sequenceFlow id="S1" sourceRef="S_start" targetRef="S_publish" />
    <bpmn:sequenceFlow id="S2" sourceRef="S_publish" targetRef="S_offer" />
    <bpmn:sequenceFlow id="S3" sourceRef="S_offer" targetRef="S_response" />
    <bpmn:sequenceFlow id="S4" sourceRef="S_response" targetRef="S_trade" />
    <bpmn:sequenceFlow id="S5" sourceRef="S_trade" targetRef="S_sendResponse" />
    <bpmn:sequenceFlow id="S6" sourceRef="S_sendResponse" targetRef="S_accept" />
    <bpmn:sequenceFlow id="S7" sourceRef="S_accept" targetRef="S_execution" />
    <bpmn:sequenceFlow id="S8" sourceRef="S_execution" targetRef="S_sendAccept" />
    <bpmn:sequenceFlow id="S11" sourceRef="S_notify" targetRef="S_confirm" />
    <bpmn:sequenceFlow id="S12" sourceRef="S_confirm" targetRef="S_complete" />
    <bpmn:sequenceFlow id="S13" sourceRef="S_complete" targetRef="S_end" />
    <bpmn:sequenceFlow id="S10" sourceRef="S_done" targetRef="S_notify" />
    <bpmn:sequenceFlow id="S9" sourceRef="S_sendAccept" targetRef="S_done" />
  </bpmn:process>
  <bpmn:process id="CarrierProcess" isExecutable="false">
    <bpmn:startEvent id="D_start" name="Заказ доступен" />
    <bpmn:userTask id="D_view" name="Просмотреть заказ" />
    <bpmn:sendTask id="D_respond" name="Откликнуться" />
    <bpmn:userTask id="D_trade" name="Участвовать в торге" />
    <bpmn:intermediateCatchEvent id="D_accept" name="Получить заказ" />
    <bpmn:userTask id="D_execute" name="Выполнить заказ" />
    <bpmn:sendTask id="D_done" name="Отметить «Заказ выполнен»" />
    <bpmn:endEvent id="D_end" name="Конец" />
    <bpmn:sequenceFlow id="D1" sourceRef="D_start" targetRef="D_view" />
    <bpmn:sequenceFlow id="D2" sourceRef="D_view" targetRef="D_respond" />
    <bpmn:sequenceFlow id="D3" sourceRef="D_respond" targetRef="D_trade" />
    <bpmn:sequenceFlow id="D4" sourceRef="D_trade" targetRef="D_accept" />
    <bpmn:sequenceFlow id="D5" sourceRef="D_accept" targetRef="D_execute" />
    <bpmn:sequenceFlow id="D6" sourceRef="D_execute" targetRef="D_done" />
    <bpmn:sequenceFlow id="D7" sourceRef="D_done" targetRef="D_end" />
  </bpmn:process>
