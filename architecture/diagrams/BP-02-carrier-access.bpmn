<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BP02" targetNamespace="https://example.com/bpmn/carrier-access" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collab_BP02">
    <bpmn:participant id="CarrierPool" name="Перевозчик" processRef="CarrierProcess" />
    <bpmn:participant id="SystemPool" name="Система" processRef="SystemProcess" />
    <bpmn:participant id="PaymentPool" name="Платёжная система" processRef="PaymentProcess" />
    <bpmn:messageFlow id="M1" name="проверить доступ" sourceRef="D_request" targetRef="S_start" />
    <bpmn:messageFlow id="M2" name="доступ активен" sourceRef="S_grant" targetRef="D_access" />
    <bpmn:messageFlow id="M3" name="купить доступ" sourceRef="D_buy" targetRef="S_purchase" />
    <bpmn:messageFlow id="M4" name="платёж" sourceRef="S_payment" targetRef="P_start" />
    <bpmn:messageFlow id="M5" name="оплата завершена" sourceRef="P_confirm" targetRef="S_paid" />
  </bpmn:collaboration>
  <bpmn:process id="CarrierProcess" isExecutable="false">
    <bpmn:startEvent id="D_start" name="Начало" />
    <bpmn:userTask id="D_view" name="Просмотреть заказы" />
    <bpmn:sendTask id="D_request" name="Проверить доступ" />
    <bpmn:intermediateCatchEvent id="D_access" name="Получить полный доступ" />
    <bpmn:exclusiveGateway id="D_gateway" name="Есть доступ?" />
    <bpmn:sendTask id="D_buy" name="Купить доступ" />
    <bpmn:intermediateCatchEvent id="D_newAccess" name="Доступ активирован" />
    <bpmn:endEvent id="D_end" name="Конец" />
    <bpmn:subProcess id="D_full" name="Полный доступ 24 часа" />
    <bpmn:userTask id="D_actions" name="Отклик / торг / принятие" />
    <bpmn:sequenceFlow id="D1" sourceRef="D_start" targetRef="D_view" />
    <bpmn:sequenceFlow id="D2" sourceRef="D_view" targetRef="D_request" />
    <bpmn:sequenceFlow id="D3" sourceRef="D_request" targetRef="D_access" />
    <bpmn:sequenceFlow id="D4" sourceRef="D_access" targetRef="D_gateway" />
    <bpmn:sequenceFlow id="D5" name="Нет" sourceRef="D_gateway" targetRef="D_buy" />
    <bpmn:sequenceFlow id="D8" name="Да" sourceRef="D_gateway" targetRef="D_full" />
    <bpmn:sequenceFlow id="D6" sourceRef="D_buy" targetRef="D_newAccess" />
    <bpmn:sequenceFlow id="D7" sourceRef="D_newAccess" targetRef="D_full" />
    <bpmn:sequenceFlow id="D10" sourceRef="D_actions" targetRef="D_end" />
    <bpmn:sequenceFlow id="D9" sourceRef="D_full" targetRef="D_actions" />
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:startEvent id="S_start" name="Запрос доступа" />
    <bpmn:serviceTask id="S_check" name="Проверить доступ" />
    <bpmn:exclusiveGateway id="S_gateway" name="Доступ активен?">
      <bpmn:outgoing>S3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="S_purchase" name="Получить запрос на покупку" />
    <bpmn:sendTask id="S_payment" name="Передать платёж" />
    <bpmn:intermediateCatchEvent id="S_paid" name="Получить подтверждение оплаты" />
    <bpmn:serviceTask id="S_activate" name="Активировать доступ на 24 часа" />
    <bpmn:endEvent id="S_end" name="Конец" />
    <bpmn:sendTask id="S_grant" name="Открыть полный доступ">
      <bpmn:incoming>S3</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="S1" sourceRef="S_start" targetRef="S_check" />
    <bpmn:sequenceFlow id="S2" sourceRef="S_check" targetRef="S_gateway" />
    <bpmn:sequenceFlow id="S4" name="Нет" sourceRef="S_gateway" targetRef="S_purchase" />
    <bpmn:sequenceFlow id="S3" name="Да" sourceRef="S_gateway" targetRef="S_grant" />
    <bpmn:sequenceFlow id="S5" sourceRef="S_purchase" targetRef="S_payment" />
    <bpmn:sequenceFlow id="S6" sourceRef="S_payment" targetRef="S_paid" />
    <bpmn:sequenceFlow id="S7" sourceRef="S_paid" targetRef="S_activate" />
    <bpmn:sequenceFlow id="S8" sourceRef="S_activate" targetRef="S_grant" />
    <bpmn:sequenceFlow id="S9" sourceRef="S_grant" targetRef="S_end" />
  </bpmn:process>
  <bpmn:process id="PaymentProcess" isExecutable="false">
    <bpmn:startEvent id="P_start" name="Получить платёж" />
    <bpmn:endEvent id="P_end" name="Конец" />
    <bpmn:sendTask id="P_confirm" name="Подтвердить оплату" />
    <bpmn:serviceTask id="P_process" name="Провести оплату" />
    <bpmn:sequenceFlow id="P1" sourceRef="P_start" targetRef="P_process" />
    <bpmn:sequenceFlow id="P3" sourceRef="P_confirm" targetRef="P_end" />
    <bpmn:sequenceFlow id="P2" sourceRef="P_process" targetRef="P_confirm" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP02">
    <bpmndi:BPMNPlane id="Plane_BP02" bpmnElement="Collab_BP02">
