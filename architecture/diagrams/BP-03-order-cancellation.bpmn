<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BP03" targetNamespace="https://example.com/bpmn/order-cancellation" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collab_BP03">
    <bpmn:participant id="CustomerPool" name="Заказчик" processRef="CustomerProcess" />
    <bpmn:participant id="CarrierPool" name="Перевозчик" processRef="CarrierProcess" />
    <bpmn:participant id="SystemPool" name="Система" processRef="SystemProcess" />
    <bpmn:participant id="OtherPool" name="Вторая сторона" processRef="OtherProcess" />
    <bpmn:messageFlow id="M_customer" name="отказ и причина" sourceRef="C_refuse" targetRef="S_start" />
    <bpmn:messageFlow id="M_carrier" name="отказ и причина" sourceRef="D_refuse" targetRef="S_start" />
    <bpmn:messageFlow id="M_notify" name="уведомление об отмене" sourceRef="S_notify" targetRef="O_receive" />
  </bpmn:collaboration>
  <bpmn:process id="CustomerProcess" isExecutable="false">
    <bpmn:laneSet id="CustomerLanes">
      <bpmn:lane id="CustomerLane" name="Заказчик" />
    </bpmn:laneSet>
    <bpmn:startEvent id="C_start" name="Заказ выполняется" />
    <bpmn:sequenceFlow id="C1" sourceRef="C_start" targetRef="C_refuse" />
    <bpmn:sequenceFlow id="C2" sourceRef="C_refuse" targetRef="C_end" />
    <bpmn:endEvent id="C_end" name="Отказ отправлен" />
    <bpmn:sendTask id="C_refuse" name="Отказаться и указать причину" />
  </bpmn:process>
  <bpmn:process id="CarrierProcess" isExecutable="false">
    <bpmn:laneSet id="CarrierLanes">
      <bpmn:lane id="CarrierLane" name="Перевозчик" />
    </bpmn:laneSet>
    <bpmn:startEvent id="D_start" name="Заказ выполняется" />
    <bpmn:sequenceFlow id="D1" sourceRef="D_start" targetRef="D_refuse" />
    <bpmn:sequenceFlow id="D2" sourceRef="D_refuse" targetRef="D_end" />
    <bpmn:endEvent id="D_end" name="Отказ отправлен" />
    <bpmn:sendTask id="D_refuse" name="Отказаться и указать причину" />
  </bpmn:process>
  <bpmn:process id="SystemProcess" isExecutable="false">
    <bpmn:laneSet id="SystemLanes">
      <bpmn:lane id="SystemLane" name="Система" />
    </bpmn:laneSet>
    <bpmn:serviceTask id="S_save" name="Сохранить причину" />
    <bpmn:serviceTask id="S_cancel" name="Отменить заказ" />
    <bpmn:sendTask id="S_notify" name="Уведомить вторую сторону" />
    <bpmn:endEvent id="S_end" name="Заказ отменён" />
    <bpmn:sequenceFlow id="S1" sourceRef="S_start" targetRef="S_save" />
    <bpmn:sequenceFlow id="S2" sourceRef="S_save" targetRef="S_cancel" />
    <bpmn:sequenceFlow id="S3" sourceRef="S_cancel" targetRef="S_notify" />
    <bpmn:sequenceFlow id="S4" sourceRef="S_notify" targetRef="S_end" />
    <bpmn:startEvent id="S_start" name="Получить отказ" />
  </bpmn:process>
  <bpmn:process id="OtherProcess" isExecutable="false">
    <bpmn:startEvent id="O_start" name="Ожидание" />
    <bpmn:endEvent id="O_end" name="Уведомлён" />
    <bpmn:intermediateCatchEvent id="O_receive" name="Получить уведомление" />
    <bpmn:sequenceFlow id="O1" sourceRef="O_start" targetRef="O_receive" />
    <bpmn:sequenceFlow id="O2" sourceRef="O_receive" targetRef="O_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP03">
    <bpmndi:BPMNPlane id="Plane_BP03" bpmnElement="Collab_BP03">
      <bpmndi:BPMNShape bpmnElement="CustomerPool" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="960" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="C_start">
        <dc:Bounds x="260" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="245" y="138" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="C_refuse">
        <dc:Bounds x="520" y="80" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="C_end">
        <dc:Bounds x="1032" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1007" y="138" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="C1_di" bpmnElement="C1">
        <di:waypoint x="296" y="120" />
        <di:waypoint x="520" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C2_di" bpmnElement="C2">
        <di:waypoint x="700" y="120" />
        <di:waypoint x="1032" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape bpmnElement="CarrierPool" isHorizontal="true">
        <dc:Bounds x="160" y="220" width="960" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="D_start">
        <dc:Bounds x="260" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="245" y="298" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="D_end">
        <dc:Bounds x="1042" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1017" y="298" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="D_refuse">
        <dc:Bounds x="670" y="240" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="D1_di" bpmnElement="D1">
        <di:waypoint x="296" y="280" />
        <di:waypoint x="670" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D2_di" bpmnElement="D2">
        <di:waypoint x="850" y="280" />
        <di:waypoint x="1042" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape bpmnElement="SystemPool" isHorizontal="true">
        <dc:Bounds x="160" y="380" width="960" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="S_start">
        <dc:Bounds x="352" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="331" y="458" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="S_save">
        <dc:Bounds x="475" y="400" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="S_cancel">
        <dc:Bounds x="680" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="S_notify">
        <dc:Bounds x="850" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="S_end">
        <dc:Bounds x="1045" y="422" width="30" height="30" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1023" y="452" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="S1_di" bpmnElement="S1">
        <di:waypoint x="388" y="440" />
        <di:waypoint x="475" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S2_di" bpmnElement="S2">
        <di:waypoint x="605" y="440" />
        <di:waypoint x="680" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S3_di" bpmnElement="S3">
        <di:waypoint x="800" y="440" />
        <di:waypoint x="850" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S4_di" bpmnElement="S4">
        <di:waypoint x="990" y="440" />
        <di:waypoint x="1015" y="440" />
        <di:waypoint x="1015" y="437" />
        <di:waypoint x="1045" y="437" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape bpmnElement="OtherPool" isHorizontal="true">
        <dc:Bounds x="160" y="540" width="960" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="O_start">
        <dc:Bounds x="712" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="704" y="618" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="O_end">
        <dc:Bounds x="1042" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1032" y="618" width="57" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="O_receive">
        <dc:Bounds x="902" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="886" y="618" width="69" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="O1_di" bpmnElement="O1">
        <di:waypoint x="748" y="600" />
        <di:waypoint x="902" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="O2_di" bpmnElement="O2">
        <di:waypoint x="938" y="600" />
        <di:waypoint x="1042" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_customer_di" bpmnElement="M_customer">
        <di:waypoint x="610" y="160" />
        <di:waypoint x="610" y="291" />
        <di:waypoint x="370" y="291" />
        <di:waypoint x="370" y="422" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="569" y="193" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_carrier_di" bpmnElement="M_carrier">
        <di:waypoint x="760" y="320" />
        <di:waypoint x="760" y="371" />
        <di:waypoint x="370" y="371" />
        <di:waypoint x="370" y="422" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="719" y="353" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_notify_di" bpmnElement="M_notify">
        <di:waypoint x="920" y="480" />
        <di:waypoint x="920" y="582" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="882" y="511" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
