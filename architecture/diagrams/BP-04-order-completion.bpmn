        <di:waypoint x="435" y="231" />
        <di:waypoint x="290" y="231" />
        <di:waypoint x="290" y="292" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="249" y="254" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_notice_di" bpmnElement="M_notice">
