      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S4_di" bpmnElement="S4">
        <di:waypoint x="930" y="310" />
        <di:waypoint x="980" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S5_di" bpmnElement="S5">
        <di:waypoint x="1140" y="310" />
        <di:waypoint x="1262" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape bpmnElement="CustomerPool" isHorizontal="true">
        <dc:Bounds x="160" y="420" width="1300" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="C_confirm">
        <dc:Bounds x="650" y="450" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="C_review">
        <dc:Bounds x="980" y="472" width="36" height="36" />
