        <di:waypoint x="540" y="470" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="510" y="392" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_confirm_di" bpmnElement="M_confirm">
